{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "my-payload-app",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    "nodejs_compat",
 "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "893519f4-ee82-4012-a0c5-3e02349211b5",
      "database_name": "my-payload-app",
      "remote": true
    }
  ],
  "services": [
   ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "my-payload-app","preview_bucket_name": "my-payload-app"
    }
  ]

}
